<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Alpha Sweep | Proprietary Educational Platform</title>
    <style>
        :root {
            --bg-main: #0a0e17;
            --bg-card: #121824;
            --accent: #00ffcc;
            --accent-hover: #00ccaa;
            --text-main: #ffffff;
            --text-muted: #8a99ad;
            --border: #1e293b;
            --danger: #ff4a4a;
            --success: #00ff66;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        }

        body {
            background-color: var(--bg-main);
            color: var(--text-main);
            padding: 20px;
        }

        header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding-bottom: 20px;
            border-bottom: 1px solid var(--border);
            margin-bottom: 30px;
        }

        .logo {
            font-size: 24px;
            font-weight: 800;
            color: var(--accent);
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .premium-badge {
            background: linear-gradient(135deg, #ffd700, #ffa500);
            color: #000;
            padding: 6px 12px;
            border-radius: 20px;
            font-weight: bold;
            font-size: 12px;
        }

        .grid {
            display: grid;
            grid-template-columns: 2fr 1fr;
            gap: 25px;
        }

        @media (max-width: 900px) {
            .grid { grid-template-columns: 1fr; }
        }

        .card {
            background-color: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 20px;
            margin-bottom: 25px;
        }

        h2 {
            font-size: 18px;
            margin-bottom: 15px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        /* Asset Table Styles */
        table {
            width: 100%;
            border-collapse: collapse;
            text-align: left;
        }

        th {
            color: var(--text-muted);
            font-size: 12px;
            text-transform: uppercase;
            padding-bottom: 10px;
            border-bottom: 1px solid var(--border);
        }

        td {
            padding: 14px 0;
            border-bottom: 1px solid var(--border);
            font-variant-numeric: tabular-nums;
        }

        .price-up { color: var(--success); }
        .price-down { color: var(--danger); }

        /* Controls & Form */
        .btn {
            background-color: var(--accent);
            color: #000;
            border: none;
            padding: 12px 20px;
            border-radius: 8px;
            font-weight: 700;
            cursor: pointer;
            width: 100%;
            transition: background 0.2s;
        }

        .btn:hover { background-color: var(--accent-hover); }

        .btn-secondary {
            background-color: transparent;
            border: 1px solid var(--border);
            color: var(--text-main);
        }
        .btn-secondary:hover { background-color: var(--border); }

        /* Bot & Lesson Layouts */
        .bot-toggle-container {
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: #1a2333;
            padding: 15px;
            border-radius: 8px;
            margin-top: 10px;
        }

        .switch {
            position: relative;
            display: inline-block;
            width: 50px;
            height: 26px;
        }

        .switch input { display: none; }

        .slider {
            position: absolute;
            cursor: pointer;
            top: 0; left: 0; right: 0; bottom: 0;
            background-color: #ccc;
            transition: .4s;
            border-radius: 34px;
        }

        .slider:before {
            position: absolute;
            content: "";
            height: 18px; width: 18px;
            left: 4px; bottom: 4px;
            background-color: white;
            transition: .4s;
            border-radius: 50%;
        }

        input:checked + .slider { background-color: var(--success); }
        input:checked + .slider:before { transform: translateX(24px); }

        .lesson-item {
            padding: 12px;
            border-left: 3px solid var(--border);
            background: #161f30;
            margin-bottom: 10px;
            border-radius: 0 6px 6px 0;
        }

        .lesson-item.completed {
            border-left-color: var(--success);
        }

        .metrics-bar {
            display: flex;
            justify-content: space-between;
            background: #161f30;
            padding: 12px;
            border-radius: 8px;
            margin-bottom: 15px;
            font-size: 14px;
        }
    </style>
</head>
